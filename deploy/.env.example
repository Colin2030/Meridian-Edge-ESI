# =============================================================================
# Meridian Edge — environment configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" in the install directory (e.g. /opt/meridian-edge/.env)
# and edit the values. The systemd service loads it via EnvironmentFile=.
#
#   cp .env.example .env
#   chmod 600 .env            # it contains the DB password and signing secret
#
# install.sh creates .env from this template automatically if one does not
# already exist, and generates a strong SESSION_SECRET for you.
# =============================================================================

# Runtime environment. Always "production" on a customer host.
NODE_ENV=production

# TCP port the Node server listens on (bound to 127.0.0.1 only; nginx proxies
# the public connection to it). Must match the proxy_pass port in the nginx
# vhost. Default: 4100.
PORT=4100

# -----------------------------------------------------------------------------
# Database (REQUIRED) — the customer's own local PostgreSQL 14+ instance.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# For a local server with password auth, HOST is typically 127.0.0.1.
# If your password contains special characters, URL-encode them.
# Example:
#   DATABASE_URL=postgresql://meridian:S3cret@127.0.0.1:5432/meridian_edge
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://meridian:CHANGE_ME@127.0.0.1:5432/meridian_edge

# -----------------------------------------------------------------------------
# Session / JWT signing secret (REQUIRED).
# Used to sign authentication tokens. MUST be a long, random, secret value and
# MUST be changed from the default. If it leaks, attackers can forge logins.
# Generate a strong value with:
#   openssl rand -hex 48
# (install.sh does this automatically when it first creates .env.)
# -----------------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_run_openssl_rand_hex_48

# -----------------------------------------------------------------------------
# Document data directory (OPTIONAL).
# Where rendered page images and staged imports are stored. Defaults to
# "<install-dir>/uploads". Set an absolute path to keep document data on a
# separate/larger volume. The service user must own this directory.
#   UPLOADS_DIR=/var/lib/meridian-edge/uploads
# -----------------------------------------------------------------------------
#UPLOADS_DIR=/opt/meridian-edge/uploads

# -----------------------------------------------------------------------------
# Maximum upload size (OPTIONAL).
# Largest single file (in BYTES) accepted on the HTTP import/upload path.
# Forensic ESI deliveries are routinely multi-GB, so the default is 0 =
# NO application-level size cap: uploads are streamed to disk and bounded only
# by free disk space on UPLOADS_DIR / the imports staging dir (and by whatever
# client_max_body_size the nginx vhost in front allows).
# Set a positive number of bytes to enforce a hard cap. Examples:
#   MAX_UPLOAD_BYTES=53687091200   # 50 GB
#   MAX_UPLOAD_BYTES=10737418240   # 10 GB
# Default: 0 (unlimited — free disk space is the real limit).
# For the very largest / air-gapped deliveries, prefer the "Network / folder
# location" (server-side path) import, which ingests with no HTTP body at all.
# -----------------------------------------------------------------------------
#MAX_UPLOAD_BYTES=0

# -----------------------------------------------------------------------------
# Max NUMBER of files per import request (OPTIONAL).
# The only application-level per-request cap enforced by Meridian Edge. Raise it
# when a single Concordance/EDRM chunk legitimately contains more than the
# default number of files (e.g. a large images/ set). This is a file COUNT, not
# a byte size (see MAX_UPLOAD_BYTES above for byte limits).
# Default: 2000.
#   MAX_UPLOAD_FILES=10000
# -----------------------------------------------------------------------------
#MAX_UPLOAD_FILES=2000

# -----------------------------------------------------------------------------
# Server-side ingest roots (OPTIONAL).
# Comma-separated list of ABSOLUTE directories from which the "Network / folder
# location" import may read loadfiles. Only paths inside one of these roots are
# permitted, to prevent arbitrary filesystem reads. Point these at your mounted
# ESI shares (SMB/NFS) or staging directories.
# Default (if unset): /home/ubuntu,/mnt,/media,/srv
#   INGEST_ALLOWED_ROOTS=/mnt/esi-shares,/srv/esi
# -----------------------------------------------------------------------------
INGEST_ALLOWED_ROOTS=/mnt,/media,/srv

# -----------------------------------------------------------------------------
# OCR (OPTIONAL). When "true", imported page images with no embedded text are
# run through Tesseract OCR at ingest time to make them searchable. Requires the
# "tesseract-ocr" OS package to be installed. This platform VIEWS pre-processed
# ESI; OCR here only indexes text for search and does not alter source documents.
# Default: false.
# -----------------------------------------------------------------------------
ENABLE_OCR=false
