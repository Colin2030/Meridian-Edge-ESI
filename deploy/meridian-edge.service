### Meridian Edge — systemd service unit (TEMPLATE)
#
# This is a TEMPLATE. The production installer (install.sh) renders it by
# substituting the placeholder tokens below (service user/group, install prefix,
# node binary) with the values chosen at install time, then symlinks the result
# into /etc/systemd/system/. Do NOT hardcode host-specific paths or users here —
# keep the placeholders so every target host installs correctly.
#
# All configuration (PORT, DATABASE_URL, SESSION_SECRET, ENABLE_OCR) comes from
# the EnvironmentFile below — no secrets are baked into this unit.

[Unit]
Description=Meridian Edge ESI Review Platform
Documentation=file://__PREFIX__/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__PREFIX__
EnvironmentFile=__PREFIX__/.env
ExecStart=__NODE_BIN__ dist/index.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meridian-edge
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
